APP_NAME=ClearCheck
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://clearcheck.deoris.test
APP_PORTAL_URL=https://deoris.test
DEORIS_PORTAL_URL=https://deoris.test
AUTH_SERVICE_URL=https://deoris.test
DEORIS_VERIFY_SSL=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=clearcheck
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.deoris.test
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CLEARCHECK_SERVICE_NAME=ClearCheck
CLEARCHECK_SERVICE_KEY=clearcheck-service
CLEARCHECK_SERVICE_URL=https://clearcheck.deoris.test
CLEARCHECK_API_VERSION=v1
CLEARCHECK_EVENT_SECRET=change-me-clearcheck
CLEARCHECK_SEARCH_TOKEN=change-me-clearcheck-search-token
REDIS_CHANNEL_EVENTS=clearance.events

REVERB_APP_ID=clearcheck
REVERB_APP_KEY=clearcheck-key
REVERB_APP_SECRET=clearcheck-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@clearcheck.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

